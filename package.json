  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nfc-manager": "4.0.0-beta.10",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "export:android": "expo export --platform android",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:production": "npx eas-cli@latest build --platform android --profile production",
    "test": "playwright test",
    "format": "prettier --write src tests *.ts *.js *.json",
    "ios": "expo run:ios --device",
    "export:ios": "expo export --platform ios",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "prebuild:ios": "expo prebuild --platform ios",
    "postinstall": "patch-package"
  },
  "private": true
}
