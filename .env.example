# Backend público para Android e iPhone.
EXPO_PUBLIC_API_URL=https://apiaranjuez.softcraftbol.com/api/v1
# Dominio público HTTPS de la web para reconocer enlaces de visita.
EXPO_PUBLIC_WEB_URL=

# Opcional: Team ID de Apple Developer para conservar la firma al regenerar iOS.
APPLE_TEAM_ID=

# Cuenta gratuita: false; equipo Apple Developer Program con NFC: true.
# Cambiarlo requiere regenerar e instalar iOS. Android conserva NFC.
IOS_NFC_ENABLED=false
